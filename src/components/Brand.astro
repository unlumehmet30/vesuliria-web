---
import { localize, ui, type Lang } from '../i18n';
interface Props { compact?: boolean; lang?: Lang; href?: string; suffix?: string; }
const { compact = false, lang = 'en', suffix } = Astro.props;
const href = Astro.props.href ?? localize(lang, '/');
---
<a class="brand" href={href} aria-label={ui[lang].home}>
  <svg class="brand-mark" width="37" height="29" viewBox="0 0 44 34" aria-hidden="true">
    <path fill="currentColor" d="M2.1 9.7H11.7L21.2 27H28.9L25.25 33.6H15.4Z" />
    <path class="brand-fold" d="M19.43 23.78L21.2 27H28.9L25.25 33.6H22.05Z" />
    <path fill="currentColor" d="M22.3 9.7H31.3L26.8 17.9H17.8Z" />
    <path class="brand-upper" d="M32.6 2.6H41.2L37.3 9.7H28.7Z" />
  </svg>
  {!compact && <span>Vesuliria</span>}
  {suffix && <em class="brand-suffix">{suffix}</em>}
</a>

<style>
  .brand-fold {
    fill: #3b3d35;
  }

  .brand-upper {
    fill: #373931;
  }

  :global(.theme-dark) .brand-fold,
  :global(.header-overlay) .brand-fold {
    fill: #d0cdc3;
  }

  :global(.theme-dark) .brand-upper,
  :global(.header-overlay) .brand-upper {
    fill: #dfdcd2;
  }
</style>
