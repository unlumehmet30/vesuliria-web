---
import type { ImageMetadata } from 'astro';
import EditorialImage from './EditorialImage.astro';
interface Props { image: ImageMetadata; device: 'browser' | 'phone'; alt: string; sizes?: string; eager?: boolean; }
const { image, device, alt, sizes = '50vw', eager = false } = Astro.props;
---
<div class:list={['device', `device-${device}`]}>
  {device === 'browser' && <div class="device-bar" aria-hidden="true"><span></span><span></span><span></span></div>}
  <div class="device-screen"><EditorialImage src={image} alt={alt} sizes={sizes} eager={eager} /></div>
</div>
