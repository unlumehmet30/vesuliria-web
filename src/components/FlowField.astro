---
const { id = 'field' } = Astro.props;
---
<div class="flow-field" aria-hidden="true" data-field={id}>
  <img class="field-image field-dark" src="/visuals/ribbon-dark.svg" alt="" width="1180" height="850" decoding="async" />
  <img class="field-image field-light" src="/visuals/ribbon-light.svg" alt="" width="1180" height="850" decoding="async" />
</div>