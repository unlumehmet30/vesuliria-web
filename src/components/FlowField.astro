---
interface Props { id?: string; }
const { id = 'field' } = Astro.props;

// A deterministic visual system, not a stock image or a decorative AI-generated sphere.
// The same field renders as translucent filaments in dark mode and a particulate wave in light mode.
const filaments = Array.from({ length: 96 }, (_, i) => {
  const n = i / 95;
  const a = 800 + i * 2.4;
  const d = `M ${a.toFixed(1)} -130 C ${(480 + i * .8).toFixed(1)} ${(90 + i * 1.8).toFixed(1)}, ${(1000 - i * 2.4).toFixed(1)} ${(205 + i * 2.2).toFixed(1)}, ${(575 - i * 1.2).toFixed(1)} ${(350 + i * 1.6).toFixed(1)} S ${(430 - i * 2.3).toFixed(1)} ${(650 + i * .6).toFixed(1)}, ${(65 + i * 2.1).toFixed(1)} 880`;
  return { d, opacity: .09 + .27 * Math.sin(n * Math.PI), width: i % 9 === 0 ? .95 : .48 };
});
const secondary = Array.from({ length: 48 }, (_, i) => {
  const n = i / 47;
  const d = `M ${(1050 + i * 1.6).toFixed(1)} ${(125 + i * 1.15).toFixed(1)} C ${(830 - i * 1.3).toFixed(1)} ${(80 + i * 3.8).toFixed(1)}, ${(720 - i * 2.1).toFixed(1)} ${(400 - i * 1.4).toFixed(1)}, ${(455 + i * 1.7).toFixed(1)} ${(525 + i * 1.1).toFixed(1)} S ${(380 + i * .9).toFixed(1)} 710, 155 930`;
  return { d, opacity: .035 + .15 * Math.sin(n * Math.PI) };
});
const waveLines = Array.from({length: 43}, (_, j) => {
  const pts = Array.from({length: 84},(_,i)=>{
    const x = 30 + i * 13.8;
    const y = 310 + j * 9.5 + 85 * Math.sin((x / 180) + j * .075) + 25 * Math.sin((x / 76) - j * .12);
    return (i===0?'M':'L') + x.toFixed(1) + ' ' + y.toFixed(1);
  });
  return { d: pts.join(' '), opacity: .055 + .19 * Math.sin(j / 42 * Math.PI) };
});
const particles = Array.from({length: 42},(_,j) => Array.from({length: 75},(_,i)=>{
  const x = 55 + i*15.3;
  const y = 295+j*10+85*Math.sin((x/180)+j*.076)+25*Math.sin((x/76)-j*.12);
  const brightness = Math.max(.08, 1-Math.abs(i-40)/55);
  return { x, y, r: i%7===0 ? 1.2 : .65, opacity: (0.09 + .40*Math.sin(j/41*Math.PI))*brightness };
})).flat();
---
<div class="flow-field" aria-hidden="true">
  <svg class="field-svg field-dark" viewBox="0 0 1200 850" preserveAspectRatio="xMidYMid slice" focusable="false">
    <defs>
      <linearGradient id={`filament-${id}`} x1="0%" y1="0%" x2="100%" y2="78%">
        <stop offset="0%" stop-color="#b1e0ce" stop-opacity=".05" />
        <stop offset="37%" stop-color="#b8c9ca" stop-opacity=".68" />
        <stop offset="78%" stop-color="#f3f5f1" stop-opacity=".96" />
        <stop offset="100%" stop-color="#98b9b5" stop-opacity=".12" />
      </linearGradient>
    </defs>
    <g fill="none" stroke={`url(#filament-${id})`} stroke-linecap="round">
      {filaments.map(p => <path d={p.d} stroke-width={p.width} opacity={p.opacity} />)}
      {secondary.map(p => <path d={p.d} stroke-width=".45" opacity={p.opacity} />)}
    </g>
    <path d="M 1080 12 C 600 180, 985 300, 570 450 S 265 705, 40 905" fill="none" stroke="#b9d0ca" stroke-width=".7" opacity=".26"/>
  </svg>
  <svg class="field-svg field-light" viewBox="0 0 1200 850" preserveAspectRatio="xMidYMid slice" focusable="false">
    <g fill="none" stroke="#283f42" stroke-width=".48">
      {waveLines.map(p => <path d={p.d} opacity={p.opacity} />)}
    </g>
    <g fill="#273e40">{particles.map(p => <circle cx={p.x} cy={p.y} r={p.r} opacity={p.opacity} />)}</g>
  </svg>
</div>
