---
import ProductTile from './ProductTile.astro';
import { projects } from '../data/projects';
import type { Lang } from '../i18n';
interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
---
<div class="tile-grid">
  {projects.map((project) => <ProductTile project={project} lang={lang} compact />)}
</div>
