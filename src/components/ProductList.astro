---
import { projects } from '../data/projects';
---
<div class="systems-area-grid">
  {projects.map((project) => (
    <a class="systems-area" href={`/work/${project.slug}/`}>
      <h3>{project.name}</h3>
      <p>{project.description}</p>
      <span aria-hidden="true">↗</span>
    </a>
  ))}
</div>
