---
import Device from './Device.astro';
import type { Project } from '../data/projects';
import { localize, type Lang } from '../i18n';
interface Props { project: Project; lang?: Lang; compact?: boolean; }
const { project, lang = 'en', compact = false } = Astro.props;
const copy = project.copy[lang];
const { theme, showcase } = project;
---
<a
  class:list={['tile', `tile-${theme.ink}`, `tile-${showcase.device}`, { 'tile-compact': compact }]}
  href={localize(lang, `/work/${project.slug}/`)}
  style={`--stage:${theme.stage};--accent:${theme.accent}`}
>
  <div class="tile-copy">
    <p class="tile-tags mono"><span>{copy.category}</span><span>{copy.status}</span></p>
    <h3>{project.name}</h3>
    <p class="tile-text">{compact ? copy.tagline : copy.description}</p>
    <span class="tile-more">{lang === 'tr' ? 'Ürünü incele' : 'See the product'} <span aria-hidden="true">→</span></span>
  </div>
  <div class="tile-visual">
    <Device image={showcase.image} device={showcase.device} alt="" sizes={compact ? '(max-width: 840px) 80vw, 30vw' : '(max-width: 840px) 90vw, 50vw'} />
  </div>
</a>
