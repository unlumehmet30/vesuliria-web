---
import EditorialImage from './EditorialImage.astro';
import type { Project } from '../data/projects';
import { localize, type Lang } from '../i18n';
interface Props { project: Project; lang?: Lang; }
const { project, lang = 'en' } = Astro.props;
const copy = project.copy[lang];
---
<a class:list={['project',`project-${project.aspect || 'landscape'}`]} href={localize(lang, `/work/${project.slug}/`)}>
<div class="project-image"><EditorialImage src={project.image} alt={copy.imageAlt} sizes="(max-width: 768px) 100vw, 50vw"/></div>
<div class="project-heading"><h2>{project.name}</h2><span aria-hidden="true">→</span></div><p>{copy.description}</p><div class="project-meta mono"><span>{copy.category}</span><span>{copy.status}{project.year && ` / ${project.year}`}</span></div>
</a>
