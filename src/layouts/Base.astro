---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
const { title = 'Vesuliria — Independent Technology Company', description = site.description, dark = false, overlay = false, noindex = false } = Astro.props;
const canonical = new URL(noindex ? '/404.html' : Astro.url.pathname, site.url);
---
<!doctype html><html lang="en"><head>
<meta charset="utf-8"/><link rel="preload" href="/fonts/instrument-serif-latin.woff2" as="font" type="font/woff2" crossorigin/><meta name="viewport" content="width=device-width, initial-scale=1"/>
<meta name="theme-color" content={dark?'#242520':'#F3F0E8'}/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:type" content="website"/><meta property="og:site_name" content="Vesuliria"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:image" content={new URL('/social.jpg',site.url)}/><meta name="twitter:card" content="summary_large_image"/>
{noindex && <meta name="robots" content="noindex,follow"/>}<link rel="icon" type="image/svg+xml" href="/favicon.svg"/>
</head><body class:list={[dark?'theme-dark':'theme-light']}><a class="skip" href="#main">Skip to content</a><Header overlay={overlay}/><main id="main" tabindex="-1"><slot/></main><Footer/>

</body></html>
