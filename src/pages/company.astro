---
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
---
<Base title="Company — Vesuliria">
  <section class="company-intro shell">
    <p class="mono section-label">Company</p>
    <div class="company-heading">
      <h1>Built to question<br />the obvious.</h1>
      <p>Vesuliria is an independent technology company. Our work spans applied research, software engineering and product development.</p>
    </div>
    <div class="company-principles">
      <article>
        <h2>Start with the problem</h2>
        <p>Define what needs to change before choosing how to build the software.</p>
      </article>
      <article>
        <h2>Test the assumptions</h2>
        <p>Use a small experiment to answer the questions that could change the design.</p>
      </article>
      <article>
        <h2>Build for daily use</h2>
        <p>Consider how people will use, operate and maintain the software.</p>
      </article>
    </div>
  </section>

  <section class="identity-section">
    <div class="shell identity-grid">
      <p class="mono section-label">Independence</p>
      <div>
        <h2>Free to follow the problem.</h2>
        <p>We choose the methods and tools that fit each problem. Sometimes that means improving an existing system. Sometimes it means building a new one.</p>
        <Action href="/capabilities" label="What we do" />
      </div>
    </div>
  </section>
</Base>
