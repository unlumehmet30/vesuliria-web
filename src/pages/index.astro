---
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
import ProductList from '../components/ProductList.astro';
import EditorialImage from '../components/EditorialImage.astro';
import atlas from '../assets/workshop/research-atlas.webp';
import { capabilities } from '../data/site';
---
<Base title="Vesuliria — Software engineering and applied research">
  <section class="brand-hero shell">
    <div class="brand-hero-copy">
      <p class="brand-kicker">Independent technology company</p>
      <h1>Research.<br />Engineering.<br />Products<span>.</span></h1>
      <p class="brand-intro">We test ideas through applied research and build the software and products that follow.</p>
      <div class="brand-actions">
        <a class="brand-button" href="#areas">Explore our capabilities <span aria-hidden="true">↓</span></a>
        <Action href="/company" label="About Vesuliria" />
      </div>
    </div>

    <figure class="brand-plate">
      <EditorialImage
        src={atlas}
        alt="Layered contour lines, grids and rust-colored geometric forms on paper"
        eager
        sizes="(max-width: 840px) 100vw, 58vw"
      />
      <figcaption class="mono">Research Atlas <span>Concept illustration</span></figcaption>
    </figure>
  </section>

  <section class="systems-areas paper" id="products">
    <div class="shell">
      <div class="systems-section-heading">
        <h2>Products</h2>
        <Action href="/work" label="View our work" />
      </div>
      <ProductList />
    </div>
  </section>

  <section class="systems-areas paper" id="areas">
    <div class="shell">
      <div class="systems-section-heading">
        <h2>Areas of work</h2>
        <Action href="/capabilities" label="View capabilities" />
      </div>
      <div class="systems-area-grid">
        {capabilities.map((capability) => (
          <a class="systems-area" href={`/capabilities#${capability.id}`}>
            <h3>{capability.name}</h3>
            <p>{capability.description}</p>
            <span aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="systems-method">
    <div class="shell systems-method-grid">
      <div>
        <h2>How we work</h2>
        <Action href="/company" label="Our approach" />
      </div>
      <ol class="systems-steps">
        <li><h3>Define the problem</h3><p>Identify what needs to change and how we’ll tell if it has improved.</p></li>
        <li><h3>Test an approach</h3><p>Build a small prototype and measure the result against a baseline.</p></li>
        <li><h3>Build for daily use</h3><p>Make the software easy to operate, diagnose and maintain.</p></li>
      </ol>
    </div>
  </section>
</Base>
