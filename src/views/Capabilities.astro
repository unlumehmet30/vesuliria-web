---
import Base from '../layouts/Base.astro';
import { capabilities } from '../data/site';
import { projects } from '../data/projects';
import { localize, type Lang } from '../i18n';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = {
  en: {
    title: 'Capabilities — Vesuliria',
    description: 'Applied machine learning, systems engineering, product development and experimental research at Vesuliria.',
    heading: 'Capabilities',
    intro: 'Four kinds of work behind our products. Open one to see where it shows up.',
    areas: 'Areas of work',
    usedIn: 'Used in',
  },
  tr: {
    title: 'Yetenekler — Vesuliria',
    description: 'Vesuliria’da uygulamalı makine öğrenmesi, sistem mühendisliği, ürün geliştirme ve deneysel araştırma.',
    heading: 'Yetenekler',
    intro: 'Ürünlerimizin arkasındaki dört iş. Birini açın, nerede kullanıldığını görün.',
    areas: 'Çalışma alanları',
    usedIn: 'Kullanıldığı yer',
  },
}[lang];
---
<Base title={t.title} description={t.description} lang={lang}>
  <section class="capabilities-intro shell">
    <div class="capabilities-heading">
      <h1>{t.heading}</h1>
      <p>{t.intro}</p>
    </div>
  </section>

  <section class="capabilities-body shell" aria-label={t.areas}>
    <div class="capability-list">
      {capabilities[lang].map((item) => (
        <details class="capability" id={item.id}>
          <summary>
            <span class="capability-name">{item.name}</span>
            <span class="capability-description">{item.description}</span>
            <span class="capability-indicator" aria-hidden="true"></span>
          </summary>
          <div class="capability-detail">
            <p>{item.detail}</p>
            <p class="capability-used mono">
              <span>{t.usedIn}</span>
              {item.usedIn.map((slug) => {
                const product = projects.find((p) => p.slug === slug);
                return product && <a class="area-chip" href={localize(lang, `/work/${slug}/`)}>{product.name} →</a>;
              })}
            </p>
          </div>
        </details>
      ))}
    </div>
  </section>
</Base>

<script>
  function openLinkedCapability() {
    const id = window.location.hash.slice(1);
    const capability = document.getElementById(id);
    if (capability instanceof HTMLDetailsElement) capability.open = true;
  }

  openLinkedCapability();
  window.addEventListener('hashchange', openLinkedCapability);
</script>
