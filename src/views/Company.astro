---
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
import ProductList from '../components/ProductList.astro';
import { localize, type Lang } from '../i18n';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = {
  en: {
    title: 'Company — Vesuliria',
    label: 'Company',
    heading: ['Every claim', 'should be checkable.'],
    intro: 'Vesuliria is an independent technology company. We build products where the evidence comes with the answer, and the person using it stays in control.',
    principles: [
      ['No number without a source', 'In AVT the model cannot write figures. Every number is placed from a recorded query and the analysis is signed.'],
      ['Measured, not promised', 'Results are reported against a baseline, with the dataset named and the limits written down.'],
      ['The user holds the switch', 'In Sketchmindai a parent turns each AI feature on, and can delete everything with one option.'],
    ],
    independence: 'Two products',
    freeHeading: 'From bank analytics to bedtime stories.',
    freeText: 'The two products could hardly be further apart. What they share is how they are built: measured, explained and in the user’s control.',
    whatWeDo: 'What we do',
  },
  tr: {
    title: 'Şirket — Vesuliria',
    label: 'Şirket',
    heading: ['Her iddia', 'kontrol edilebilmeli.'],
    intro: 'Vesuliria bağımsız bir teknoloji şirketidir. Kanıtı cevapla birlikte veren, kullanan kişiyi kontrolde tutan ürünler yaparız.',
    principles: [
      ['Kaynaksız sayı yok', 'AVT’de model rakam yazamaz. Her sayı kayıtlı bir sorgudan yerleştirilir ve analiz imzalanır.'],
      ['Söz değil, ölçüm', 'Sonuçlar bir karşılaştırma noktasına göre verilir; veri kümesi adıyla, sınırlar yazılı olarak.'],
      ['Düğme kullanıcıda', 'Sketchmindai’da her yapay zekâ özelliğini ebeveyn açar; tek seçenekle her şeyi silebilir.'],
    ],
    independence: 'İki ürün',
    freeHeading: 'Banka analitiğinden uyku masallarına.',
    freeText: 'İki ürün birbirinden olabildiğince uzak. Ortak noktaları nasıl yapıldıkları: ölçülmüş, açıklanmış ve kullanıcının kontrolünde.',
    whatWeDo: 'Ne yapıyoruz',
  },
}[lang];
---
<Base title={t.title} lang={lang}>
  <section class="company-intro shell">
    <p class="mono section-label">{t.label}</p>
    <div class="company-heading">
      <h1>{t.heading[0]}<br />{t.heading[1]}</h1>
      <p>{t.intro}</p>
    </div>
    <div class="company-principles">
      {t.principles.map(([title, text]) => (
        <article>
          <h2>{title}</h2>
          <p>{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="identity-section">
    <div class="shell identity-grid">
      <p class="mono section-label">{t.independence}</p>
      <div>
        <h2>{t.freeHeading}</h2>
        <p>{t.freeText}</p>
        <Action href={localize(lang, '/capabilities')} label={t.whatWeDo} />
      </div>
    </div>
  </section>

  <section class="company-products shell">
    <ProductList lang={lang} />
  </section>
</Base>
