---
import Base from '../layouts/Base.astro';
import Action from '../components/Action.astro';
import ProductList from '../components/ProductList.astro';
import EditorialImage from '../components/EditorialImage.astro';
import atlas from '../assets/workshop/research-atlas.webp';
import { capabilities } from '../data/site';
import { projects } from '../data/projects';
import { localize, type Lang } from '../i18n';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const l = (path: string) => localize(lang, path);
const t = {
  en: {
    title: 'Vesuliria — Software engineering and applied research',
    kicker: 'Independent technology company',
    heading: ['Software that', 'shows its work'],
    intro: 'Vesuliria builds AI products you can check. Analytics where every number traces back to a query. A children’s app whose AI stays off until a parent says yes.',
    explore: 'Explore our capabilities',
    about: 'About Vesuliria',
    atlasAlt: 'Layered contour lines, grids and rust-colored geometric forms on paper',
    atlasCaption: 'Concept illustration',
    products: 'Products',
    viewWork: 'View our work',
    areas: 'Areas of work',
    viewCapabilities: 'View capabilities',
    how: 'How we work',
    approach: 'Our approach',
    usedIn: 'Used in',
    example: 'Example',
    steps: [
      ['Write the question down', 'Before any code: what has to change, and how will we know?', 'AVT: why did the SME default rate rise over the last 12 months?'],
      ['Beat a baseline', 'A small prototype, measured against the simplest thing that could work.', 'AVT: F1 1.00 against 0.40 for a naive method.'],
      ['Make it safe to run', 'Permissions, logs and deletion are built in from day one.', 'Sketchmindai: every AI feature is off until a parent turns it on.'],
    ],
  },
  tr: {
    title: 'Vesuliria — Yazılım mühendisliği ve uygulamalı araştırma',
    kicker: 'Bağımsız teknoloji şirketi',
    heading: ['Ne yaptığını', 'gösteren yazılım'],
    intro: 'Vesuliria, kontrol edilebilen yapay zekâ ürünleri yapar. Her sayısı bir sorguya dayanan bir analitik. Yapay zekâsı ebeveyn izin verene kadar kapalı duran bir çocuk uygulaması.',
    explore: 'Yeteneklerimize göz atın',
    about: 'Vesuliria hakkında',
    atlasAlt: 'Kâğıt üzerinde katmanlı eş yükselti çizgileri, ızgaralar ve pas rengi geometrik biçimler',
    atlasCaption: 'Konsept illüstrasyon',
    products: 'Ürünler',
    viewWork: 'İşlerimizi görün',
    areas: 'Çalışma alanları',
    viewCapabilities: 'Yetenekleri görün',
    how: 'Nasıl çalışırız',
    approach: 'Yaklaşımımız',
    usedIn: 'Kullanıldığı yer',
    example: 'Örnek',
    steps: [
      ['Soruyu yaz', 'Koddan önce: ne değişmeli ve değiştiğini nasıl anlayacağız?', 'AVT: son 12 ayda KOBİ temerrüt oranı neden arttı?'],
      ['Basit yöntemi geç', 'Küçük bir prototip, işe yarayabilecek en basit yönteme karşı ölçülür.', 'AVT: klasik yöntemin 0,40’ına karşı F1 1,00.'],
      ['Güvenle çalışsın', 'İzinler, kayıtlar ve silme ilk günden içinde gelir.', 'Sketchmindai: ebeveyn açana kadar her yapay zekâ özelliği kapalı.'],
    ],
  },
}[lang];
---
<Base title={t.title} lang={lang}>
  <section class="brand-hero shell">
    <div class="brand-hero-copy">
      <p class="brand-kicker">{t.kicker}</p>
      <h1>{t.heading[0]}<br />{t.heading[1]}<span>.</span></h1>
      <p class="brand-intro">{t.intro}</p>
      <div class="brand-actions">
        <a class="brand-button" href="#areas">{t.explore} <span aria-hidden="true">↓</span></a>
        <Action href={l('/company')} label={t.about} />
      </div>
    </div>

    <figure class="brand-plate">
      <EditorialImage
        src={atlas}
        alt={t.atlasAlt}
        eager
        sizes="(max-width: 840px) 100vw, 58vw"
      />
      <figcaption class="mono">Research Atlas <span>{t.atlasCaption}</span></figcaption>
    </figure>
  </section>

  <section class="systems-areas paper" id="products">
    <div class="shell">
      <div class="systems-section-heading">
        <h2>{t.products}</h2>
        <Action href={l('/work')} label={t.viewWork} />
      </div>
      <ProductList lang={lang} />
    </div>
  </section>

  <section class="systems-areas paper" id="areas">
    <div class="shell">
      <div class="systems-section-heading">
        <h2>{t.areas}</h2>
        <Action href={l('/capabilities')} label={t.viewCapabilities} />
      </div>
      <ol class="area-list">
        {capabilities[lang].map((capability, index) => (
          <li>
            <a class="area-row" href={`${l('/capabilities')}#${capability.id}`}>
              <span class="area-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="area-main">
                <span class="area-name">{capability.name}</span>
                <span class="area-text">{capability.description}</span>
              </span>
              <span class="area-used mono">
                <span class="area-used-label">{t.usedIn}</span>
                {capability.usedIn.map((slug) => <span class="area-chip">{projects.find((p) => p.slug === slug)?.name}</span>)}
              </span>
              <span class="area-arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="systems-method">
    <div class="shell method-grid">
      <div>
        <h2>{t.how}</h2>
        <Action href={l('/company')} label={t.approach} />
      </div>
      <ol class="method-steps">
        {t.steps.map(([title, text, example], index) => (
          <li>
            <span class="method-index">{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
            <p class="method-example"><span class="mono">{t.example}</span>{example}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>
