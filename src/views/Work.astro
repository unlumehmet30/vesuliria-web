---
import Base from '../layouts/Base.astro';
import ProductTile from '../components/ProductTile.astro';
import { projects } from '../data/projects';
import type { Lang } from '../i18n';

interface Props { lang?: Lang; }
const { lang = 'en' } = Astro.props;
const t = {
  en: { title: 'Work — Vesuliria', description: 'Products and projects from Vesuliria.', heading: 'Work', intro: 'Products we build and run ourselves. Each one starts as a question and ships when it holds up in use.', products: 'Products' },
  tr: { title: 'İşler — Vesuliria', description: 'Vesuliria’nın ürünleri ve projeleri.', heading: 'İşler', intro: 'Kendi geliştirip yürüttüğümüz ürünler. Her biri bir soruyla başlar, kullanımda ayakta kaldığında yayına çıkar.', products: 'Ürünler' },
}[lang];
---
<Base title={t.title} description={t.description} lang={lang}>
  <section class="work-intro shell">
    <div class="work-heading">
      <h1>{t.heading}</h1>
      <p>{t.intro}</p>
    </div>
  </section>

  <section class="tile-stack shell" aria-label={t.products}>
    {projects.map((project) => <ProductTile project={project} lang={lang} />)}
  </section>
</Base>
